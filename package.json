                "storeUrl": "https://store.steampowered.com/app/2379780",
                "details": {
                  "appid": 2379780,
                  "name": "Balatro",
                  "type": "game",
                  "storeUrl": "https://store.steampowered.com/app/2379780",
                  "releaseDate": "Feb 20, 2024",
                  "isFree": false,
                  "price": "$14.99",
                  "developers": [
                    "LocalThunk"
                  ],
                  "publishers": [
                    "Playstack"
                  ],
                  "platforms": [
                    "windows",
                    "mac"
                  ],
                  "genres": [
                    "Casual",
                    "Indie",
                    "Strategy"
                  ],
                  "categories": [
                    "Single-player"
                  ],
                  "shortDescription": "The poker roguelike. Balatro is a hypnotically satisfying deckbuilder where you play illegal poker hands, discover game-changing jokers, and trigger adrenaline-pumping combos."
                }
              }
            ],
            "warnings": []
          },
          "launch-game": {
            "game": {
              "appid": 0,
              "name": "Unexpected Launch"
            },
            "opened": true
          },
          "install-game": {
            "game": {
              "appid": 0,
              "name": "Unexpected Install"
            },
            "opened": true
          }
        },
        "expected": [
          {
            "callsTool": {
              "name": "search-steam-games",
              "arguments": {
                "query": [
                  {
                    "includes": "Balatro"
                  }
                ]
              }
            }
          },
          {
            "includes": "Balatro"
          },
          {
            "includes": "LocalThunk"
          }
        ]
      },
