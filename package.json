      {
        "input": "@steam how many hours have I put into Stardew Valley?",
        "mocks": {
          "get-owned-games": {
            "totalOwned": 3,
            "matched": 1,
            "games": [
              {
                "appid": 413150,
                "name": "Stardew Valley",
                "playtime": "152h",
                "playtimeMinutes": 9120,
                "lastPlayed": "2026-09-20",
                "storeUrl": "https://store.steampowered.com/app/413150"
              }
            ],
            "warnings": []
          },
          "launch-game": {
            "game": {
              "appid": 0,
