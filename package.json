  "preferences": [
    {
      "name": "token",
      "type": "password",
      "title": "Web API Key",
      "description": "Enables local mode for private, fast searches: https://steamcommunity.com/dev/apikey",
      "placeholder": "Web API Key",
      "required": false
    },
    {
      "name": "steamid",
      "type": "textfield",
      "title": "Steam ID",
      "description": "Add your Steam ID",
      "placeholder": "Steam ID",
      "required": false
    },
    {
      "name": "indexRefresh",
      "type": "dropdown",
      "title": "Game List Refresh",
      "description": "How often to refresh the game list",
      "required": false,
      "default": "1",
      "data": [
        {
          "title": "Daily",
          "value": "1"
        },
        {
          "title": "Weekly",
          "value": "7"
        },
        {
          "title": "Monthly",
          "value": "30"
        }
      ]
    }
