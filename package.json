{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "steam",
  "title": "Steam",
  "description": "Search and view information about any game on steam, as well as games you own.",
  "icon": "command-icon.png",
  "author": "KevinBatdorf",
  "contributors": [
    "litomore",
    "taken",
    "clins1994"
  ],
  "crossExtensions": [
    "litomore/protondb",
    "litomore/steamgriddb"
  ],
  "categories": [
    "Media",
    "Fun"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "steam",
      "title": "Search Games",
      "subtitle": "Steam",
      "description": "Search the Steam api for game information.",
      "mode": "view"
    },
    {
      "name": "search-users",
      "title": "Search Users",
      "subtitle": "Steam",
      "description": "Search Steam users and view public profile information.",
      "mode": "view"
    }
  ],
  "tools": [
    {
      "name": "search-steam-games",
      "title": "Search Steam Games",
      "description": "Search Steam games by title and return matching apps with optional public store details."
    },
    {
      "name": "get-steam-game-details",
      "title": "Get Steam Game Details",
      "description": "Get public Steam store details for a Steam app by app ID, Steam store URL, or title search."
    },
    {
      "name": "search-steam-users",
      "title": "Search Steam Users",
      "description": "Search Steam users by Steam ID, profile URL, vanity URL, or display name and return public profile information."
    },
    {
      "name": "get-owned-games",
      "title": "Get Owned Games",
      "description": "List the games you own on Steam with playtime and when each was last played. Needs your Web API Key and Steam ID."
    },
    {
      "name": "get-recently-played-games",
      "title": "Get Recently Played Games",
      "description": "List the games you played on Steam in the last two weeks. Needs your Web API Key and Steam ID."
    },
    {
      "name": "get-game-news",
      "title": "Get Game News",
      "description": "Get recent announcements, patch notes, and press coverage for a Steam game."
    },
    {
      "name": "launch-game",
      "title": "Launch Game",
      "description": "Launch a Steam game through the Steam client, after you confirm."
    },
    {
      "name": "install-game",
      "title": "Install Game",
      "description": "Open Steam's install dialog for a game, after you confirm."
    }
  ],
  "ai": {
    "instructions": "Use Search Steam Games for broad Steam game title searches and Get Steam Game Details when the user asks about one game or provides a Steam app ID/store URL. Use Search Steam Users when the user asks about a Steam user or profile. Prefer direct Steam IDs, profile URLs, and vanity URLs when present. Display-name user search can return multiple people, so do not claim an exact identity unless the result came from a Steam ID, profile URL, or vanity URL. Use Get Owned Games for questions about the user's own library and playtime, and Get Recently Played Games for what they played lately. Use Get Game News for updates, patches, or news about a game. Only use Launch Game or Install Game when the user explicitly asks to play, launch, or install a game. Both need an app ID: get it from Search Steam Games or Get Owned Games first.",
    "evals": [
      {
        "input": "@steam find Stardew Valley",
        "mocks": {
          "search-steam-games": {
            "query": "Stardew Valley",
            "results": [
              {
                "appid": 413150,
                "name": "Stardew Valley",
                "storeUrl": "https://store.steampowered.com/app/413150"
              }
            ],
            "warnings": []
          },
          "launch-game": {
            "game": {
              "appid": 0,
              "name": "Unexpected Launch"
            },
            "opened": true
          },
          "install-game": {
            "game": {
              "appid": 0,
              "name": "Unexpected Install"
            },
            "opened": true
          }
        },
        "expected": [
          {
            "callsTool": {
              "name": "search-steam-games",
              "arguments": {
                "query": [
                  {
                    "includes": "Stardew"
                  }
                ]
              }
            }
          },
          {
            "includes": "Stardew Valley"
          },
          {
            "includes": "413150"
          }
        ]
      },
      {
        "input": "@steam tell me about app 220",
        "mocks": {
          "get-steam-game-details": {
            "query": "220",
            "match": {
              "appid": 220,
              "name": "Half-Life 2",
              "storeUrl": "https://store.steampowered.com/app/220",
              "matchType": "appid"
            },
            "game": {
              "appid": 220,
              "name": "Half-Life 2",
              "type": "game",
              "storeUrl": "https://store.steampowered.com/app/220",
              "releaseDate": "Nov 16, 2004",
              "isFree": false,
              "price": "$9.99",
              "developers": [
                "Valve"
              ],
              "publishers": [
                "Valve"
              ],
              "platforms": [
                "windows",
                "mac",
                "linux"
              ],
              "genres": [
                "Action"
              ],
              "categories": [
                "Single-player"
              ],
              "metacriticScore": 96,
              "shortDescription": "1998. HALF-LIFE sends a shock through the game industry with its combination of pounding action and continuous, immersive storytelling."
            },
            "warnings": []
          },
          "launch-game": {
            "game": {
              "appid": 0,
              "name": "Unexpected Launch"
            },
            "opened": true
          },
          "install-game": {
            "game": {
              "appid": 0,
              "name": "Unexpected Install"
            },
            "opened": true
          }
        },
        "expected": [
          {
            "callsTool": "get-steam-game-details"
          },
          {
            "includes": "Half-Life 2"
          },
          {
            "includes": "Valve"
          }
        ]
      },
      {
